+        // MP4 (2026-11-04): with indexed input reads (IPA with an index register) the inputs were one array of 16 vec4
+        // decorated with the interpolation of location 0 alone, while the shader header gives each location its own:
+        // a flat integer (Metroid Prime 4's glowing fruit pass an instance index at location 8, a denormal as a float)
+        // came out interpolated and flushed to zero, and the fruit read another object's light data, flickering. Each
+        // location the header uses is declared on its own with its interpolation, and the indexed reads go to a private
+        // array of 16 vec4 that main fills from them first (SpirvGenerator.Generate, Instructions.GetStoragePointer).
+        private static void DeclareIndexedFragmentInputs(CodeGenContext context)
+        {
+            if (context.IndexedInputCopy != null)
+            {
+                return;
+            }
+
+            SpvInstruction vec4 = context.TypeVector(context.TypeFP32(), 4);
+            SpvInstruction arrayType = context.TypeArray(vec4, context.Constant(context.TypeU32(), Constants.MaxAttributes));
+            SpvInstruction copy = context.Variable(context.TypePointer(StorageClass.Private, arrayType), StorageClass.Private);
+            context.AddGlobalVariable(copy);
+            context.IndexedInputCopy = copy;
+
+            for (int location = 0; location < Constants.MaxAttributes; location++)
+            {
+                PixelImap iq = context.Definitions.ImapTypes[location].GetFirstUsedType();
+
+                if (iq == PixelImap.Unused)
+                {
+                    continue;
+                }
+
+                SpvInstruction spvVar = context.Variable(context.TypePointer(StorageClass.Input, vec4), StorageClass.Input);
+                context.Decorate(spvVar, Decoration.Location, (LiteralInteger)location);
+
+                if (iq == PixelImap.Constant)
+                {
+                    context.Decorate(spvVar, Decoration.Flat);
+                }
+                else if (iq == PixelImap.ScreenLinear)
+                {
+                    context.Decorate(spvVar, Decoration.NoPerspective);
+                }
+
+                context.AddGlobalVariable(spvVar);
+                context.IndexedInputs.Add((location, spvVar));
+            }
+        }
+
+        // Fills the private copy of the indexed inputs at the start of main: the locations the header leaves unused read
+        // (0, 0, 0, 0).
+        public static void FillIndexedFragmentInputs(CodeGenContext context)
+        {
+            if (context.IndexedInputCopy == null)
+            {
+                return;
+            }
+
+            SpvInstruction vec4 = context.TypeVector(context.TypeFP32(), 4);
+            SpvInstruction pointerType = context.TypePointer(StorageClass.Private, vec4);
+            SpvInstruction[] values = new SpvInstruction[Constants.MaxAttributes];
+
+            foreach ((int location, SpvInstruction variable) in context.IndexedInputs)
+            {
+                values[location] = context.Load(vec4, variable);
+            }
+
+            for (int location = 0; location < Constants.MaxAttributes; location++)
+            {
+                SpvInstruction value = values[location] ?? context.ConstantNull(vec4);
+                SpvInstruction element = context.AccessChain(pointerType, context.IndexedInputCopy, context.Constant(context.TypeS32(), location));
+                context.Store(element, value);
+            }
+        }
